# ==============================================================================
# EMIL AĞALAROV EDTECH & STUDENT MANAGEMENT PLATFORM - MÜHİT DƏYİŞƏNLƏRİ (ENV)
# ==============================================================================
#
# Tətbiq ilkin olaraq tam funksional Mock / LocalStorage rejimində işləyir.
# Hər hansı xarici verilənlər bazası qoşmadan dərhal bütün funksiyaları test edə bilərsiniz.
#
# Canlı Supabase və ya Firebase qoşmaq istədikdə bu faylı `.env` olaraq kopyalayın
# və müvafiq açarları qeyd edin.

# ------------------------------------------------------------------------------
# 1. OPTİON A: SUPABASE INTEGRATION (Tövsiyə olunur)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. OPTİON B: FIREBASE INTEGRATION (Firestore + Auth)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=emil-agalarov-edtech.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=emil-agalarov-edtech
VITE_FIREBASE_STORAGE_BUCKET=emil-agalarov-edtech.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
